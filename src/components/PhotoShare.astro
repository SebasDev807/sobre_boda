---
import './styles/PhotoShare.css';
---

<section class="photo-section">
  <div class="photo-card">
    <h2 class="photo-title fade-up">Comparte las fotos de la Boda</h2>

    <!-- Ícono de cámara SVG elegante -->
    <div class="camera-icon-wrapper fade-up">
      <svg class="camera-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Cuerpo de la cámara -->
        <path
          d="M15 35 H30 L36 24 H64 L70 35 H85 C87.8 35 90 37.2 90 40 V80 C90 82.8 87.8 85 85 85 H15 C12.2 85 10 82.8 10 80 V40 C10 37.2 12.2 35 15 35 Z"
          stroke="var(--color-accent)"
          stroke-width="2"
          fill="none"
        />
        <!-- Lente exterior -->
        <circle cx="50" cy="60" r="17" stroke="var(--color-accent)" stroke-width="2" fill="none" />
        <!-- Lente interior (reflejo) -->
        <circle cx="50" cy="60" r="10" stroke="var(--color-accent)" stroke-width="1.5" fill="none" stroke-dasharray="3 2" />
        <!-- Punto de grabación -->
        <circle cx="22" cy="46" r="3" fill="var(--color-accent)" />
        <!-- Flash -->
        <rect x="75" y="42" width="8" height="5" rx="1.5" fill="none" stroke="var(--color-accent)" stroke-width="1.5"/>
        <!-- Líneas decorativas laterales -->
        <line x1="15" y1="52" x2="15" y2="75" stroke="var(--color-accent)" stroke-width="1" stroke-dasharray="2 3" opacity="0.5"/>
        <line x1="85" y1="52" x2="85" y2="75" stroke="var(--color-accent)" stroke-width="1" stroke-dasharray="2 3" opacity="0.5"/>
      </svg>
    </div>

    <h3 class="photo-hashtag fade-up">#Edwin&amp;Vaneza</h3>

    <p class="photo-text fade-up">
      Comparte tus momentos favoritos con el hashtag de la boda.<br/>
      ¡Cada foto cuenta nuestra historia!
    </p>

    <a
      href="https://www.instagram.com/explore/tags/edwinvaneza/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-photo fade-up"
    >
      Ver Instagram
    </a>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const photoSection = document.querySelector('.photo-section');
    if (photoSection) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-on-scroll');
          }
        });
      }, { threshold: 0.2 });
      observer.observe(photoSection);
    }
  });
</script>
