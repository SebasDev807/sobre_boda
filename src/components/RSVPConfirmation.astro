---
import "./styles/RSVPConfirmation.css";
import colibri from "../assets/colibri.gif";
import flores4 from "../assets/flores_4.png";
import flores5 from "../assets/flores_5.png";
---

<section class="rsvp-section">
  <!-- Flores decorativas esquina superior izquierda -->
  <img src={flores5.src} alt="" class="rsvp-flower rsvp-flower-tl" />

  <div class="rsvp-card">
    <!-- Texto superior -->
    <p class="rsvp-tagline">Con todo nuestro amor</p>
    <h2 class="rsvp-title">¿Nos confirmas<br />tu asistencia?</h2>
    <div class="rsvp-divider"></div>

    <p class="rsvp-body">
      Para nosotros es muy importante contar contigo en este día tan especial.
      Por favor confírmanos tu asistencia e <strong>indícanos el número de adultos y niños</strong> que nos acompañarán al llenar el formulario.
    </p>

    <!-- Botones -->
    <div class="rsvp-buttons">
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSdMtDvvH7U3dOoy9l7kr988Stiy5gtomM55_mPW1kyQUZHk9g/viewform?usp=publish-editor"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-rsvp-confirm"
        id="rsvp-confirm-btn"
      >
        ✓ Confirmar asistencia
      </a>
    </div>
  </div>

  <!-- Colibrí al final de la página -->
  <div class="rsvp-colibri-wrapper">
    <img src={colibri.src} alt="Colibrí" class="rsvp-colibri" />
  </div>

  <!-- Flores decorativas abajo -->
  <img src={flores4.src} alt="" class="rsvp-flower rsvp-flower-bottom" />
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const rsvpSection = document.querySelector(".rsvp-section");
    if (rsvpSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("animate-on-scroll");
            }
          });
        },
        { threshold: 0.1 },
      );
      observer.observe(rsvpSection);
    }
  });
</script>
