---
import marcoFlores from "../assets/flores_1.png";
import cornerFlores from "../assets/flores_2.png";
import cornerFlores3 from "../assets/flores_3.png";
import trigo1 from "../assets/trigo_1.png";
import hojas1 from "../assets/hojas-1.png";
import flores4 from "../assets/flores_4.png";
import flores5 from "../assets/flores_5.png";
import './styles/ImageAnimationScreen.css';
---

<div id="image-animation-screen" class="animation-screen">
  <div class="frame-container">
    <!-- El marco de flores por encima de las imágenes -->
    <img src={marcoFlores.src} alt="Marco decorativo" class="flower-frame" />

    <!-- Adornos de las esquinas -->
    <img
      src={cornerFlores.src}
      alt="Esquina superior derecha"
      class="corner-flower corner-tr"
    />
    <img
      src={cornerFlores.src}
      alt="Esquina inferior izquierda"
      class="corner-flower corner-bl"
    />

    <!-- Detalles extra de esquinas (flores_3) -->
    <img
      src={cornerFlores3.src}
      alt="Detalle superior derecha"
      class="corner-flower corner-tr"
    />
    <img
      src={cornerFlores3.src}
      alt="Detalle inferior izquierda"
      class="corner-flower corner-bl"
    />

    <!-- Elementos con animación de viento (trigo y hojas) -->
    <div class="swaying-container">
      <!-- Esquina Superior Derecha -->
      <img src={trigo1.src} alt="" class="wheat swaying-element wheat-tr-1" />
      <img src={trigo1.src} alt="" class="wheat swaying-element wheat-tr-2" />
      <img src={trigo1.src} alt="" class="wheat swaying-element wheat-tr-3" />
      <img src={hojas1.src} alt="" class="leaf swaying-element leaf-tr-1" />
      <img src={hojas1.src} alt="" class="leaf swaying-element leaf-tr-2" />

      <!-- Esquina Inferior Izquierda -->
      <img src={trigo1.src} alt="" class="wheat swaying-element wheat-bl-1" />
      <img src={trigo1.src} alt="" class="wheat swaying-element wheat-bl-2" />
      <img src={trigo1.src} alt="" class="wheat swaying-element wheat-bl-3" />
      <img src={hojas1.src} alt="" class="leaf swaying-element leaf-bl-1" />
      <img src={hojas1.src} alt="" class="leaf swaying-element leaf-bl-2" />
    </div>

    <!-- Contenedor de las imágenes de fondo animadas -->
    <div class="images-container">
      <img
        src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&q=80"
        alt="Boda 1"
        class="anim-image active"
      />
      <img
        src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=800&q=80"
        alt="Boda 2"
        class="anim-image"
      />
      <img
        src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=800&q=80"
        alt="Boda 3"
        class="anim-image"
      />
    </div>

    <!-- Contenedor central vacío -->
  </div>

  <!-- NUEVA PANTALLA CÚPULA -->
  <div class="cupula-section">
    <!-- Flores esquina superior izquierda -->
    <img src={flores5.src} alt="Flores esquina" class="cupula-tl-flowers" />

    <div class="arch-container">
      <p class="arch-pretitle">Con la bendición de Dios y nuestros padres</p>
      <p class="arch-subtitle">¡Nos Casamos!</p>

      <div class="arch-names-wrapper">
        <span class="arch-ampersand">&</span>
        <h2 class="arch-name">EDWIN</h2>
        <h2 class="arch-name">VANEZA</h2>
      </div>

      <p class="arch-date">08 - 01 - 25</p>
      <p class="arch-message">
        Queremos compartir contigo el día más feliz de nuestras vidas.
      </p>
    </div>

    <!-- Flores al final de la cúpula, ocupando todo el ancho de la sección -->
    <img
      src={flores4.src}
      alt="Flores decorativas"
      class="section-bottom-flowers"
    />
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const envelopeContainer = document.querySelector(
      ".interactive-envelope-container",
    );
    const animationScreen = document.getElementById("image-animation-screen");
    let currentImageIdx = 0;
    const images = document.querySelectorAll(".anim-image");
    let intervalId: number;

    if (envelopeContainer && animationScreen) {
      envelopeContainer.addEventListener("click", () => {
        // Fade in de la pantalla al dar clic al sobre
        animationScreen.classList.add("visible");

        // Iniciar animación de imágenes si no está corriendo
        if (images.length > 0 && !intervalId) {
          intervalId = window.setInterval(() => {
            images[currentImageIdx].classList.remove("active");
            currentImageIdx = (currentImageIdx + 1) % images.length;
            images[currentImageIdx].classList.add("active");
          }, 3500); // Cambiar imagen cada 3.5 segundos
        }
      });
    }

    // Animación al hacer scroll hacia la cúpula
    const cupulaSection = document.querySelector(".cupula-section");
    const archContainer = document.querySelector(".arch-container");

    if (cupulaSection && archContainer) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              archContainer.classList.add("animate-in");
              cupulaSection.classList.add("animate-in");
            }
          });
        },
        { threshold: 0.3 },
      );

      observer.observe(cupulaSection);
    }
  });
</script>
