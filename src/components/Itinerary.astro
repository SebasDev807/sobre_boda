---
import './styles/Itinerary.css';
import { Icon } from 'astro-icon/components';
---

<section class="itinerary-section">
  <h2 class="section-title fade-up">Itinerario</h2>
  
  <div class="timeline-container fade-up">
    <!-- Línea central -->
    <div class="timeline-line"></div>

    <!-- 6:00 pm -->
    <div class="timeline-item left-aligned">
      <div class="timeline-content">
        <p class="timeline-desc">Ceremonia en la capilla</p>
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-time">
        <Icon name="material-symbols:church" class="icon" />
        <p>6:00 pm</p>
      </div>
    </div>

    <!-- 6:45 pm -->
    <div class="timeline-item right-aligned">
      <div class="timeline-time">
        <p>6:45 pm</p>
        <Icon name="material-symbols:celebration" class="icon" />
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-content">
        <p class="timeline-desc">Salida de novios · Calle de honor · Show de fuegos pirotécnicos</p>
      </div>
    </div>

    <!-- 6:55 pm -->
    <div class="timeline-item left-aligned">
      <div class="timeline-content">
        <p class="timeline-desc">Sesión de fotos en salón · Invitados en salitas VIP con café y colaciones</p>
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-time">
        <Icon name="material-symbols:photo-camera" class="icon" />
        <p>6:55 pm</p>
      </div>
    </div>

    <!-- 7:30 pm -->
    <div class="timeline-item right-aligned">
      <div class="timeline-time">
        <p>7:30 pm</p>
        <Icon name="material-symbols:meeting-room" class="icon" />
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-content">
        <p class="timeline-desc">Ingreso de invitados al salón · Ubicación en mesas asignadas</p>
      </div>
    </div>

    <!-- 8:00 pm -->
    <div class="timeline-item left-aligned">
      <div class="timeline-content">
        <p class="timeline-desc">Ingreso oficial de los esposos al salón</p>
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-time">
        <Icon name="material-symbols:favorite" class="icon" />
        <p>8:00 pm</p>
      </div>
    </div>

    <!-- 8:05 pm -->
    <div class="timeline-item right-aligned">
      <div class="timeline-time">
        <p>8:05 pm</p>
        <Icon name="material-symbols:local-bar" class="icon" />
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-content">
        <p class="timeline-desc">Brindis a cargo de los novios</p>
      </div>
    </div>

    <!-- 8:10 pm -->
    <div class="timeline-item left-aligned">
      <div class="timeline-content">
        <p class="timeline-desc">Inicio del servicio · Sesión de fotos mesa por mesa</p>
        <ul class="timeline-menu">
          <li><span class="menu-cat">Entrada</span> Torta red velvet</li>
          <li><span class="menu-cat">Fuerte</span> Lomo de cerdo en salsa de higos · Pollo embajador relleno de jamón y queso en salsa de champiñones · Arroz con ajonjolí · Rollo de papa · Ensalada Waldorf</li>
          <li><span class="menu-cat">Postre</span> Apertura de mesa de pasabocas</li>
        </ul>
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-time">
        <Icon name="material-symbols:restaurant" class="icon" />
        <p>8:10 pm</p>
      </div>
    </div>

    <!-- 9:00 pm -->
    <div class="timeline-item right-aligned">
      <div class="timeline-time">
        <p>9:00 pm</p>
        <Icon name="material-symbols:music-note" class="icon" />
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-content">
        <p class="timeline-desc">Primer baile como esposos · Apertura de la fiesta</p>
      </div>
    </div>

    <!-- 11:00 pm -->
    <div class="timeline-item left-aligned">
      <div class="timeline-content">
        <p class="timeline-desc">La novia lanzará el ramo · El novio el botonnier</p>
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-time">
        <Icon name="material-symbols:local-florist" class="icon" />
        <p>11:00 pm</p>
      </div>
    </div>

    <!-- 12:30 am -->
    <div class="timeline-item right-aligned">
      <div class="timeline-time">
        <p>12:30 am</p>
        <Icon name="material-symbols:nightlife" class="icon" />
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-content">
        <p class="timeline-desc">Hora loca a cargo de IVM</p>
      </div>
    </div>

    <!-- 3:00 am -->
    <div class="timeline-item left-aligned">
      <div class="timeline-content">
        <p class="timeline-desc">Fin del evento</p>
      </div>
      <div class="timeline-dot"></div>
      <div class="timeline-time">
        <Icon name="material-symbols:nights-stay" class="icon" />
        <p>3:00 am</p>
      </div>
    </div>

  </div>

  <div class="itinerary-footer fade-up">
    <h3 class="footer-title">Nuestro Amor</h3>
    <p class="footer-quote">"Quiero estar contigo, ahora y para siempre"</p>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const itinerarySection = document.querySelector('.itinerary-section');
    if (itinerarySection) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-on-scroll');
            
            // Animar elementos de la línea de tiempo uno por uno
            const items = entry.target.querySelectorAll('.timeline-item');
            items.forEach((item, index) => {
              setTimeout(() => {
                item.classList.add('visible');
              }, index * 200); // 200ms de retraso entre cada elemento
            });
          }
        });
      }, { threshold: 0.1 });
      
      observer.observe(itinerarySection);
    }
  });
</script>
