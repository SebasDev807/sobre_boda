---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import Envelope from "../components/Envelope.astro";
import ImageAnimationScreen from "../components/ImageAnimationScreen.astro";
import "./index.css";
---

<Layout title="Invitación de Boda - E & V">
  <div class="app-background">
    <main class="mobile-frame">
      <section class="content-section">
        <div class="fade-in" style="animation-delay: 0.1s;">
          <Logo />
        </div>

        <div class="guest-info fade-in" style="animation-delay: 0.3s;">
          <h1 class="guest-name" id="index-guest-name">Sra. Daniela Garcia</h1>
          <p class="guest-details" id="index-guest-details">
            CUPOS: 3
          </p>
        </div>

        <div class="message fade-in" style="animation-delay: 0.5s;">
          <p>
            Este sueño no estaría completo sin ti.<br />
            ¡Haz clic en el sobre y acompáñanos en nuestra<br />
            historia de amor!
          </p>
        </div>

        <div class="fade-in" style="width: 100%; animation-delay: 0.7s;" id="envelope-wrapper">
          <Envelope />
          <!-- Overlay de bloqueo cuando falta el nombre -->
          <div class="envelope-blocked-overlay" id="envelope-blocked" aria-hidden="true">
            <span class="material-symbols-outlined blocked-icon">lock</span>
          </div>
        </div>

        <!-- Panel de error: sobre sin nombre -->
        <div class="no-name-error" id="no-name-error" role="alert" aria-live="polite">
          <span class="material-symbols-outlined error-icon">sentiment_dissatisfied</span>
          <p class="error-title">Este sobre no tiene destinatario</p>
          <p class="error-desc">El enlace de esta invitación no incluye un nombre. Por favor pide al remitente que te comparta el enlace correcto.</p>
        </div>
      </section>

      <footer class="footer fade-in" style="animation-delay: 0.9s;">
        <p>E &amp; V</p>
      </footer>
    </main>
    <ImageAnimationScreen />
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const urlParams = new URLSearchParams(window.location.search);
    const invitado = urlParams.get("invitado");
    const genero    = urlParams.get("g");
    const cupos     = urlParams.get("cupos");


    const errorPanel      = document.getElementById("no-name-error");
    const envelopeBlocked = document.getElementById("envelope-blocked");
    const envelopeWrapper = document.getElementById("envelope-wrapper");
    const messageDiv      = document.querySelector(".message") as HTMLElement | null;
    const guestInfo       = document.querySelector(".guest-info") as HTMLElement | null;

    // ── Sin nombre: mostrar error y bloquear sobre ──
    if (!invitado || !invitado.trim()) {
      if (errorPanel)      errorPanel.classList.add("visible");
      if (envelopeBlocked) envelopeBlocked.classList.add("visible");
      if (envelopeWrapper) envelopeWrapper.classList.add("blocked");
      if (messageDiv)      messageDiv.style.display = "none";
      if (guestInfo)       guestInfo.style.display  = "none";
      return; // Nada más que hacer
    }

    // ── Con nombre: construir prefijo ──
    let prefijo = "Sr. "; // Por defecto
    if (genero) {
      const g = genero.toUpperCase();
      if      (g === "M")  prefijo = "Sr. ";
      else if (g === "F")  prefijo = "Sra. ";
      else if (g === "FM") prefijo = "Familia ";
    }

    const nameEl = document.getElementById("index-guest-name");
    if (nameEl) {
      nameEl.textContent = `${prefijo}${invitado.trim()}`;
    }

    const detailsEl = document.getElementById("index-guest-details");
    if (detailsEl) {
      if (cupos) detailsEl.innerHTML = `CUPOS: ${cupos}`;
      else       detailsEl.style.display = "none";
    }
  });
</script>
