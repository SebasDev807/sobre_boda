---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Envelope from '../components/Envelope.astro';
import ImageAnimationScreen from '../components/ImageAnimationScreen.astro';
import './index.css';
---

<Layout title="Invitación de Boda - E & V">
  <div class="app-background">
    <main class="mobile-frame">
      <section class="content-section">
        <div class="fade-in" style="animation-delay: 0.1s;">
          <Logo />
        </div>
        
        <div class="guest-info fade-in" style="animation-delay: 0.3s;">
          <h1 class="guest-name">Sra. Daniela Garcia</h1>
          <p class="guest-details">Cupos: 3 &mdash; Mesa: 4</p>
        </div>
        
        <div class="message fade-in" style="animation-delay: 0.5s;">
          <p>
            Este sueño no estaría completo sin ti.<br/>
            ¡Haz clic en el sobre y acompáñanos en nuestra<br/>
            historia de amor!
          </p>
        </div>
        
        <div class="fade-in" style="width: 100%; animation-delay: 0.7s;">
          <Envelope />
        </div>
      </section>
      
      <footer class="footer fade-in" style="animation-delay: 0.9s;">
        <p>E &amp; V</p>
      </footer>
    </main>
    <ImageAnimationScreen />
  </div>
</Layout>
