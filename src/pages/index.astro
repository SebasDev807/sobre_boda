---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Envelope from '../components/Envelope.astro';
---

<Layout title="Invitación de Boda - E & V">
  <div class="app-background">
    <main class="mobile-frame">
      <section class="content-section">
        <div class="fade-in" style="animation-delay: 0.1s;">
          <Logo />
        </div>
        
        <div class="guest-info fade-in" style="animation-delay: 0.3s;">
          <h1 class="guest-name">Sra. Daniela Garcia</h1>
          <p class="guest-details">Cupos: 3 &mdash; Mesa: 4</p>
        </div>
        
        <div class="message fade-in" style="animation-delay: 0.5s;">
          <p>
            Este sueño no estaría completo sin ti.<br/>
            ¡Haz clic en el sobre y acompáñanos en nuestra<br/>
            historia de amor!
          </p>
        </div>
        
        <div class="fade-in" style="width: 100%; animation-delay: 0.7s;">
          <Envelope />
        </div>
      </section>
      
      <footer class="footer fade-in" style="animation-delay: 0.9s;">
        <p>E &amp; V</p>
      </footer>
    </main>
  </div>
</Layout>

<style>
  /* Fondo general (se nota en pantallas de escritorio) */
  .app-background {
    background-color: #EFE9E1; /* Pergamino/Taupe suave para contrastar con el blanco cálido */
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
    padding: 0;
  }

  /* Marco del móvil simulado */
  .mobile-frame {
    width: 100%;
    max-width: 414px; /* Ancho típico de un iPhone Max */
    min-height: 100vh;
    background-color: var(--color-bg-main); /* Blanco cálido */
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 3rem 1.5rem 2rem 1.5rem;
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    
    /* Ocultar barra de desplazamiento visualmente pero permitir scroll */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE y Edge */
  }

  /* Ocultar barra de desplazamiento para Chrome, Safari y Opera */
  .mobile-frame::-webkit-scrollbar {
    display: none;
  }

  /* Adaptación para pantallas más grandes (Escritorio) */
  @media (min-width: 640px) {
    .app-background {
      padding: 2rem 0;
    }
    .mobile-frame {
      min-height: auto;
      height: 896px; /* Altura fija para mantener proporción móvil en escritorio */
      border-radius: 40px;
      border: 12px solid white;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }
  }

  /* Sección de contenido */
  .content-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-grow: 1;
    justify-content: flex-start;
  }

  /* Info de invitado */
  .guest-info {
    margin: 1.5rem 0;
  }

  .guest-name {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: var(--weight-medium);
    font-style: italic;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .guest-details {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-top: 0;
  }

  /* Mensaje romántico */
  .message {
    margin: 1rem 0 2rem 0;
    padding: 0 1rem;
  }

  .message p {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-main);
    opacity: 0.8;
  }

  /* Footer */
  .footer {
    text-align: center;
    margin-top: 2rem;
  }

  .footer p {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    opacity: 0.6;
    margin: 0;
  }
</style>
